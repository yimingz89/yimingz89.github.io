rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner(uid) {
      return request.auth != null
        && request.auth.uid == uid
        && request.auth.token.email_verified == true
        && request.auth.token.email == 'OWNER_GOOGLE_EMAIL'
        && request.auth.token.firebase.sign_in_provider == 'google.com';
    }

    match /users/{uid}/cards/{cardId} {
      allow read: if isOwner(uid);
      allow create, update: if isOwner(uid)
        && cardId.matches('^[1-9][0-9]{0,5}:[^/]{1,4}$')
        && request.resource.data.keys().hasOnly(['star', 'rating', 'updatedAt'])
        && request.resource.data.keys().hasAll(['updatedAt'])
        && ('star' in request.resource.data || 'rating' in request.resource.data)
        && (!('star' in request.resource.data)
          || request.resource.data.star in ['none', 'keep-fresh', 'learning'])
        && (!('rating' in request.resource.data)
          || request.resource.data.rating in ['unrated', 'review', 'learned'])
        && request.resource.data.updatedAt == request.time;
      // Keep explicit "none"/"unrated" markers so stale devices cannot revive removals.
      allow delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
